{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "description": "User defined input for the LoadDataToIceberg StateMachine",
    "required": ["SourceFileTableNameMapping"],
    "properties": {
        "SourceFileTableNameMapping": {
            "description": "Explicit list of source file to table name mappings",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["SourceFile"],
                "properties": {
                    "SourceFile": {
                        "description": "S3 object key (not full URI) of the source file.",
                        "type": "string",
                        "minLength": 1
                    },
                    "TableName": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "additionalProperties": false
            }
        },
        "Event": {
            "description": "Original EventBridge event metadata — passed through for auditing only",
            "type": "object"
        }
    },
    "additionalProperties": false
}
