{
    "Comment": "Serverless ETL state machine — runs one EMR Serverless Iceberg job per bin-packed group of files.",
    "QueryLanguage": "JSONata",
    "StartAt": "Validate Input",
    "States": {
        "Validate Input": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
                "FunctionName": "${ValidateInputFunctionArn}",
                "Payload": "{% $states.input %}"
            },
            "Output": "{% $states.result.Payload %}",
            "Next": "Load Groups"
        },
        "Load Groups": {
            "Type": "Map",
            "Items": "{% $states.input.Groups %}",
            "ItemProcessor": {
                "ProcessorConfig": {
                    "Mode": "INLINE"
                },
                "StartAt": "Load Data",
                "States": {
                    "Load Data": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::emr-serverless:startJobRun.sync",
                        "TimeoutSeconds": 600,
                        "Arguments": {
                            "ApplicationId": "${EMRServerlessApplicationId}",
                            "ExecutionRoleArn": "${ExecutionRoleArn}",
                            "ClientToken": "{% $uuid() %}",
                            "Name": "{% 'iceberg-load-batch-' & $states.context.Execution.Name & '-grp' & $string($states.input.GroupIndex) & '-' & $string($count($states.input.SourceFileTableNameMapping)) & 'files' %}",
                            "JobDriver": {
                                "SparkSubmit": {
                                    "EntryPoint": "${PySparkScriptLocation}",
                                    "EntryPointArguments": "{% [ $string([$map($states.input.SourceFileTableNameMapping, function($m) { { 'SourceFile': 's3://${DataBucket}/' & $m.SourceFile, 'TableName': $m.TableName } })]), '${GlueCatalogId}', 'default', 's3://${DataBucket}/runs/' & $states.context.Execution.Name & '/stats/grp' & $string($states.input.GroupIndex) & '.json' ] %}",
                                    "SparkSubmitParameters": "--conf spark.jars=/usr/share/aws/iceberg/lib/iceberg-spark3-runtime.jar --conf spark.sql.extensions=org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions --conf spark.sql.catalog.s3tablesbucket=org.apache.iceberg.spark.SparkCatalog --conf spark.sql.catalog.s3tablesbucket.type=rest --conf spark.sql.catalog.s3tablesbucket.uri=https://glue.${AWS::Region}.amazonaws.com/iceberg --conf spark.sql.catalog.s3tablesbucket.warehouse=${GlueCatalogId} --conf spark.sql.catalog.s3tablesbucket.rest.sigv4-enabled=true --conf spark.sql.catalog.s3tablesbucket.rest.signing-name=glue --conf spark.sql.catalog.s3tablesbucket.rest.signing-region=${AWS::Region}"
                                }
                            }
                        },
                        "Retry": [
                            {
                                "ErrorEquals": [
                                    "EmrServerless.EmrServerlessException",
                                    "EMRServerless.AWSEMRServerlessException",
                                    "EMRServerless.ValidationException"
                                ],
                                "IntervalSeconds": 15,
                                "MaxAttempts": 10,
                                "BackoffRate": 2
                            }
                        ],
                        "Output": "{% $states.input %}",
                        "Next": "Check Stats Object",
                        "Catch": [{
                            "ErrorEquals": ["States.ALL"],
                            "Next": "Group Failed",
                            "Output": "{% $states.input %}"
                        }]
                    },
                    "Check Stats Object": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::aws-sdk:s3:headObject",
                        "Arguments": {
                            "Bucket": "${DataBucket}",
                            "Key": "{% 'runs/' & $states.context.Execution.Name & '/stats/grp' & $string($states.input.GroupIndex) & '.json' %}"
                        },
                        "Output": "{% $merge([$states.input, { 'stats': { 'status': 'available', 'uri': 's3://${DataBucket}/runs/' & $states.context.Execution.Name & '/stats/grp' & $string($states.input.GroupIndex) & '.json' } }]) %}",
                        "Next": "Emit Job Complete",
                        "Catch": [{
                            "ErrorEquals": ["States.ALL"],
                            "Next": "Emit Job Complete",
                            "Output": "{% $merge([$states.input, { 'stats': { 'status': 'unavailable', 'uri': 's3://${DataBucket}/runs/' & $states.context.Execution.Name & '/stats/grp' & $string($states.input.GroupIndex) & '.json' } }]) %}",
                            "Comment": "Stats are optional telemetry; a missing object does not fail a committed group"
                        }]
                    },
                    "Emit Job Complete": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::events:putEvents",
                        "Arguments": {
                            "Entries": [{
                                "EventBusName": "default",
                                "Source": "etl.pipeline",
                                "DetailType": "GroupLoadComplete",
                                "Detail": {
                                    "runId": "{% $states.context.Execution.Name %}",
                                    "groupIndex": "{% $states.input.GroupIndex %}",
                                    "fileCount": "{% $count($states.input.SourceFileTableNameMapping) %}",
                                    "totalSize": "{% $states.input.TotalSize %}",
                                    "tableCount": "{% $states.input.TableCount %}",
                                    "stats": {
                                        "status": "{% $states.input.stats.status %}",
                                        "uri": "{% $states.input.stats.uri %}"
                                    }
                                }
                            }]
                        },
                        "Output": "{% $states.input %}",
                        "Next": "Group Succeeded",
                        "Catch": [{
                            "ErrorEquals": ["States.ALL"],
                            "Next": "Group Succeeded",
                            "Output": "{% $states.input %}",
                            "Comment": "Event emission failure is non-fatal"
                        }]
                    },
                    "Group Succeeded": {
                        "Type": "Pass",
                        "Output": "{% { 'status': 'succeeded', 'groupIndex': $states.input.GroupIndex, 'fileCount': $count($states.input.SourceFileTableNameMapping), 'stats': $states.input.stats } %}",
                        "End": true
                    },
                    "Group Failed": {
                        "Type": "Pass",
                        "Output": "{% { 'status': 'failed', 'groupIndex': $states.input.GroupIndex } %}",
                        "End": true
                    }
                }
            },
            "Output": "{% $states.result %}",
            "Next": "Check Group Results"
        },
        "Check Group Results": {
            "Type": "Choice",
            "Choices": [{
                "Condition": "{% $count($states.input[status = 'failed']) > 0 %}",
                "Next": "Fail"
            }],
            "Default": "Succeed"
        },
        "Succeed": {
            "Type": "Succeed"
        },
        "Fail": {
            "Type": "Fail"
        }
    }
}
